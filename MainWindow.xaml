<Window x:Class="MlnetGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MlnetGui.ViewModels"
        Title="ML.NET GUI" Height="820" Width="1100">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Данные и параметры" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
            <StackPanel>
                <Button Content="Выбрать файл…" Command="{Binding BrowseCommand}"/>
                <TextBlock Text="{Binding DatasetPath}" TextWrapping="Wrap" Margin="0,4"/>
                <Label Content="Колонка метки (0-based)"/>
                <TextBox Text="{Binding LabelColumn}"/>
                <CheckBox Content="В файле есть заголовок" IsChecked="{Binding HasHeader}"/>
                <Label Content="Имя модели"/>
                <TextBox Text="{Binding ModelName}"/>
                <Label Content="Время обучения (сек)"/>
                <TextBox Text="{Binding TrainTime}"/>
                <Label Content="Папка вывода"/>
                <TextBox Text="{Binding OutputDir}"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Предпросмотр" Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
            <ListView ItemsSource="{Binding PreviewLines}" FontFamily="Consolas"/>
        </GroupBox>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,8">
            <Button Content="Обучить" Command="{Binding TrainCommand}" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="Стоп"    Command="{Binding StopCommand}"  Padding="12,4"/>
        </StackPanel>

        <GroupBox Header="Лог mlnet" Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
            <ListBox ItemsSource="{Binding LogLines}" FontFamily="Consolas"/>
        </GroupBox>

        <GroupBox Header="Классификация" Grid.Row="0" Grid.Column="1" Grid.RowSpan="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Открыть папку результатов" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"/>
                    <Button Content="Модифицировать сгенерированный Program.cs" Command="{Binding ModifyAppCommand}"/>
                </StackPanel>

                <TextBox Grid.Row="1" Height="80" Margin="0,8"
                 Text="{Binding UserText, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                <Button Grid.Row="2" Content="Классифицировать" Command="{Binding PredictCommand}"
                HorizontalAlignment="Left" Padding="12,4"/>
                <GroupBox Grid.Row="3" Header="Результат">
                    <TextBlock Text="{Binding PredictionResult}" FontSize="18" FontWeight="Bold"/>
                </GroupBox>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
    